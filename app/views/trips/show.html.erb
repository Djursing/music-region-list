<% content_for :title, @trip.display_name %>
<% content_for :wide, true %>

<div class="space-y-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight"><%= @trip.display_name %></h1>
      <p class="mt-1 text-sm text-neutral-500">
        <%= pluralize(@artist_counts.size, "artist") %> across
        <%= pluralize(@zone_assignments.size, "kommune") %>
        · from <%= link_to @trip.playlist.display_name, @trip.playlist, class: "underline underline-offset-4 hover:text-neutral-300" %>
      </p>
    </div>
    <div class="flex shrink-0 gap-2">
      <%= link_to "Drive", drive_trip_path(@trip),
            class: "rounded-md bg-emerald-500 px-3 py-1.5 text-sm font-medium text-neutral-950 hover:bg-emerald-400" %>
      <%= button_to "Re-roll", @trip, method: :patch,
            class: "rounded-md border border-neutral-700 px-3 py-1.5 text-sm hover:border-neutral-500" %>
      <%= link_to "All trips", trips_path, class: "rounded-md border border-neutral-800 px-3 py-1.5 text-sm text-neutral-400 hover:text-neutral-100" %>
    </div>
  </div>

  <% if @silent_borders.positive? %>
    <div class="rounded-lg border border-amber-900 bg-amber-950/40 px-4 py-3 text-sm text-amber-100/90">
      <strong class="font-medium text-amber-200"><%= pluralize(@silent_borders, "kommune") %></strong>
      share an artist with a neighbour, so those crossings won't change the music.
      <% if @artist_counts.size < Trips::ZoneAssigner::MINIMUM_POOL_FOR_CLEAN_MAP %>
        With <%= pluralize(@artist_counts.size, "artist") %> that is unavoidable —
        <%= Trips::ZoneAssigner::MINIMUM_POOL_FOR_CLEAN_MAP %> is enough to colour the whole map cleanly.
      <% else %>
        Re-rolling will usually clear them.
      <% end %>
    </div>
  <% end %>

  <div data-controller="map"
       data-map-boundaries-url-value="<%= kommuner_boundaries_path %>"
       data-map-zones-value="<%= @trip.map_zones.to_json %>"
       class="grid gap-4 lg:grid-cols-[1fr_20rem]">

    <div class="relative overflow-hidden rounded-lg border border-neutral-800">
      <div data-map-target="canvas" class="h-[28rem] w-full lg:h-[34rem]"></div>
      <p data-map-target="status" class="sr-only" role="status" aria-live="polite"></p>
    </div>

    <aside class="rounded-lg border border-neutral-800 bg-neutral-900/50 p-4">
      <%= turbo_frame_tag "zone_panel" do %>
        <p class="text-sm text-neutral-500">
          Select a kommune on the map to see its artist and swap it.
        </p>
      <% end %>
    </aside>
  </div>

  <div id="map_events" class="hidden"></div>

  <div class="space-y-3">
    <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">Artists on the map</h2>
    <ul class="grid gap-2 sm:grid-cols-2">
      <% palette = @trip.artist_palette %>
      <% @zone_assignments.group_by(&:artist).sort_by { |_, zones| -zones.size }.each do |artist, zones| %>
        <li class="flex items-center gap-2 rounded-md border border-neutral-800 px-3 py-2 text-sm">
          <span class="inline-block h-3 w-3 shrink-0 rounded-full"
                style="background-color: <%= palette[artist.id] %>"></span>
          <span class="truncate"><%= artist.name %></span>
          <span class="ml-auto shrink-0 text-neutral-500"><%= pluralize(zones.size, "kommune") %></span>
        </li>
      <% end %>
    </ul>
  </div>

  <details class="rounded-lg border border-neutral-800">
    <summary class="cursor-pointer px-4 py-3 text-sm text-neutral-400">
      Every kommune as a list
    </summary>
    <ul id="zone_assignments" class="divide-y divide-neutral-800 border-t border-neutral-800">
      <%= render partial: "trips/zones/zone", collection: @zone_assignments.sort_by(&:kommune_name), as: :zone %>
    </ul>
  </details>
</div>
