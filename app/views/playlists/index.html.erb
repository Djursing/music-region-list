<% content_for :title, "Playlists" %>

<div class="space-y-8">
  <div class="space-y-2">
    <h1 class="text-2xl font-semibold tracking-tight">Import a playlist</h1>
    <p class="max-w-prose text-sm text-neutral-400">
      Every artist on the playlist becomes a candidate for a kommune. Paste a link
      to a playlist <strong class="text-neutral-200">you own or collaborate on</strong> —
      since February 2026 Spotify no longer exposes the contents of anyone else's
      playlists, including its own editorial ones. To use one of those, make a copy
      in Spotify first and import the copy.
    </p>
  </div>

  <%= form_with model: @playlist, url: playlists_path, class: "space-y-3" do |f| %>
    <%= f.label :link, "Playlist link", class: "block text-sm font-medium" %>
    <div class="flex gap-2">
      <%= f.text_field :link,
            placeholder: "https://open.spotify.com/playlist/…",
            autocomplete: "off",
            class: "flex-1 rounded-md border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm placeholder:text-neutral-600 focus:border-emerald-500 focus:outline-none" %>
      <%= f.submit "Import", class: "rounded-md bg-emerald-500 px-4 py-2 text-sm font-medium text-neutral-950 hover:bg-emerald-400 cursor-pointer" %>
    </div>
    <p class="text-xs text-neutral-500">
      Accepts a share link, a <code>spotify:playlist:…</code> URI, or a bare playlist ID.
    </p>
  <% end %>

  <% if @playlists.any? %>
    <div class="space-y-3">
      <h2 class="text-sm font-medium uppercase tracking-wide text-neutral-500">Imported</h2>
      <ul class="divide-y divide-neutral-800 rounded-lg border border-neutral-800">
        <% @playlists.each do |playlist| %>
          <li class="flex items-center justify-between px-4 py-3">
            <div>
              <%= link_to playlist.display_name, playlist, class: "font-medium hover:underline underline-offset-4" %>
              <p class="text-xs text-neutral-500">
                <%= render "playlists/status_line", playlist: playlist %>
              </p>
            </div>
            <%= button_to "Remove", playlist, method: :delete,
                  class: "text-xs text-neutral-500 hover:text-neutral-300",
                  form: { data: { turbo_confirm: "Remove #{playlist.display_name}?" } } %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
